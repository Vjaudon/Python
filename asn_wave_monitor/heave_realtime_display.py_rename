"""
heave_realtime_display.py

Connects to an Exail Phins Surface via TCP, parses the StdBin protocol natively, 
and displays a real-time rolling graph of the heave data over a 1-minute window.
Utilizes the internal INS timestamp to guarantee accurate visualization.
"""

import socket
import struct
import threading
import time
from collections import deque
import matplotlib.pyplot as plt
import matplotlib.animation as animation

# --- Network & Application Configuration ---
INS_IP = "192.168.137.126"
INS_PORT = 8111
BUFFER_TIME_SECONDS = 60.0

# Thread-safe data structures for GUI synchronization
time_buffer = deque()
heave_buffer = deque()
data_lock = threading.Lock()

def extract_heave_and_time(buffer):
    """
    Parses the Exail StdBin byte stream to find the synchronization header, 
    decodes the navigation mask up to Bit 2, and extracts both the heave value
    and the native INS timestamp.
    
    Returns:
        tuple: (heave_value, ins_time_seconds, bytes_consumed)
    """
    if len(buffer) < 32:
        return None, None, 0
        
    sync_idx = buffer.find(b'IX')
    if sync_idx == -1:
        return None, None, len(buffer)
        
    buf = buffer[sync_idx:]
    if len(buf) < 32:
        return None, None, sync_idx
        
    try:
        offset = 2
        version = buf[offset]
        offset += 1
        
        nav_mask = int.from_bytes(buf[offset:offset+4], byteorder='big')
        offset += 4
        
        ext_nav_mask = int.from_bytes(buf[offset:offset+4], byteorder='big')
        offset += 4
        
        ext_mask = int.from_bytes(buf[offset:offset+4], byteorder='big')
        offset += 4
        
        if version > 3:
            nav_size = int.from_bytes(buf[offset:offset+2], byteorder='big')
            offset += 2
            
        total_telegram_size = int.from_bytes(buf[offset:offset+2], byteorder='big')
        offset += 2
        
        if len(buf) < total_telegram_size:
            return None, None, sync_idx
            
        # Extract the INS internal timestamp (100 microseconds resolution)
        nav_validity = int.from_bytes(buf[offset:offset+4], byteorder='big')
        ins_time_seconds = nav_validity * 1e-4
        offset += 4
        
        counter = int.from_bytes(buf[offset:offset+4], byteorder='big')
        offset += 4
        
        heave_val = None
        
        # Traverse enabled data blocks sequentially
        if nav_mask & (1 << 0):
            offset += 12
            
        if nav_mask & (1 << 1):
            offset += 12
            
        if nav_mask & (1 << 2):
            if offset + 16 <= total_telegram_size:
                heave_val = struct.unpack_from('>4f', buf, offset)[1]
                
        return heave_val, ins_time_seconds, sync_idx + total_telegram_size
        
    except Exception as e:
        print(f"Parsing structural exception: {e}")
        return None, None, sync_idx + 2

def network_worker():
    """
    Manages the TCP connection lifecycle and buffers the incoming binary stream.
    """
    buffer = b""
    
    while True:
        try:
            print(f"Connecting to Exail INS at {INS_IP}:{INS_PORT}...")
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
                sock.settimeout(5.0)
                sock.connect((INS_IP, INS_PORT))
                print("TCP connection established successfully.")
                
                sock.settimeout(None) 
                
                while True:
                    data = sock.recv(4096)
                    if not data:
                        print("Connection closed by the INS.")
                        break
                        
                    buffer += data
                    
                    while True:
                        heave_val, ins_time, consumed = extract_heave_and_time(buffer)
                        
                        if consumed == 0:
                            break
                            
                        if heave_val is not None and ins_time is not None:
                            with data_lock:
                                # Reset arrays if time flows backwards (e.g., simulation loop)
                                if time_buffer and ins_time < time_buffer[-1]:
                                    time_buffer.clear()
                                    heave_buffer.clear()
                                    
                                time_buffer.append(ins_time)
                                heave_buffer.append(heave_val)
                                
                                # Enforce the rolling window based on physical INS time
                                while time_buffer and (ins_time - time_buffer[0] > BUFFER_TIME_SECONDS):
                                    time_buffer.popleft()
                                    heave_buffer.popleft()
                                    
                        buffer = buffer[consumed:]
                        
        except socket.error as e:
            print(f"Network interruption ({e}). Retrying in 5 seconds...")
            time.sleep(5)
            buffer = b""

def update_plot(frame, ax, line):
    """
    Refreshes the Matplotlib graph using the temporally synchronized arrays.
    """
    with data_lock:
        if not time_buffer:
            return line,
            
        # Normalize the native INS time so the latest entry sits at X=0
        latest_time = time_buffer[-1]
        t_data = [(t - latest_time) for t in time_buffer]
        y_data = list(heave_buffer)
        
    line.set_data(t_data, y_data)
    
    ax.set_xlim(-BUFFER_TIME_SECONDS, 0)
    
    if y_data:
        min_y, max_y = min(y_data), max(y_data)
        margin = max(0.05, (max_y - min_y) * 0.15)
        ax.set_ylim(min_y - margin, max_y + margin)
        
    return line,

def main():
    net_thread = threading.Thread(target=network_worker, daemon=True)
    net_thread.start()
    
    fig, ax = plt.subplots(figsize=(10, 5))
    line, = ax.plot([], [], lw=1.5, color='#2ca02c')
    
    ax.set_title("Exail Phins Surface - Real-Time Heave")
    ax.set_xlabel("Time (Seconds Ago)")
    ax.set_ylabel("Heave (Meters)")
    ax.grid(True, linestyle=':', alpha=0.8)
    
    ani = animation.FuncAnimation(
        fig, 
        update_plot, 
        fargs=(ax, line), 
        interval=100, 
        blit=False, 
        cache_frame_data=False
    )
    
    plt.tight_layout()
    plt.show()

if __name__ == "__main__":
    main()